  <script type="application/json" data-target="react-app.embeddedData">{"payload":{},"title":"GitHub Copilot","appPayload":{"ssoOrganizations":[],"enterpriseSandboxEnabled":true,"copilotUpsellBannerDismissed":false,"showCopilotSpacesMcpBanner":true,"previewUrl":"https://viewscreen.githubusercontent.com","helpUrl":"https://docs.github.com","apiURL":"https://api.individual.githubcopilot.com","apiVersion":"2025-05-01","currentUserLogin":"tuyendath09852-sys","customInstructions":null,"customCopilotsEnabled":true,"customCopilotsIndividualAccessEnabled":true,"personalInstructions":null,"reviewLab":false,"realIp":null,"scrollToTop":false,"icebreakers":[{"type":"functional","data":[{"id":"create-bug-issue","message":"Hi Copilot! Could you please start a draft issue for a bug? Once you've created the draft issue, if you need more information, ask me 1-2 key questions. If you also think I should upload any information or images that would help write the bug issue, let me know.","titleHtml":"Create an issue for a bug","icon":"issue-opened","color":"var(--display-green-fgColor)"},{"id":"summarize-pulls","message":"Hi Copilot! Could you help summarize a pull request? I'd like to know its purpose and the key changes made. Please include details about the problem it solves, new features or functionality introduced, any breaking changes, testing done, and documentation updates. Thank you!","titleHtml":"Summarize a pull request","icon":"git-pull-request","color":"var(--display-green-fgColor)"},{"id":"code-feedback","message":"Hi Copilot! Please review my code for best practices, readability, performance, and potential bugs. First, prompt me to provide the link to the relevant GitHub repository or file. Then, offer concrete suggestions for improvement, explain any issues you discover, and provide example corrections where appropriate.","titleHtml":"Get code feedback","icon":"code","color":"var(--display-gray-fgColor)"},{"id":"next-steps-issue","message":"Hi Copilot! Could you suggest the next actionable steps for an issue, based on either the provided issue link or a copy pasted description?","titleHtml":"Suggest next steps for an issue","icon":"issue-opened","color":"var(--display-green-fgColor)"},{"id":"understand-arch-diagram","message":"Hi Copilot! Could you please help me interpret this architecture diagram?","titleHtml":"Interpret an architecture diagram","icon":"eye","color":"var(--display-purple-fgColor)"},{"id":"create-profile-readme","message":"Hi Copilot! Please create a standout profile README for $$USERNAME$$. Ask me for any key details (such as my profession, top skills, favorite projects, or social links) that would help you personalize it.","titleHtml":"Create a profile README for me","icon":"rocket","color":"var(--display-pink-fgColor)"},{"id":"my-open-pulls","message":"Hi Copilot! Can you please find my open pull requests?","titleHtml":"My open pull requests","icon":"git-pull-request","color":"var(--display-green-fgColor)"},{"id":"make-pong","message":"Hi Copilot! Could you generate a simple Pong game utilizing HTML, CSS, and JavaScript? The player should control the left paddle with their mouse, and the right paddle should be controlled automatically by a basic AI. Make sure the game includes a bouncing ball and collision detection for paddles and walls. Please provide the code for all three components: the HTML file, the CSS file, and the JavaScript file directly within the chat window. Thanks!","titleHtml":"Make a Pong game","icon":"code","color":"var(--display-gray-fgColor)"}]},{"type":"instructional","data":[]},{"type":"interactional","data":[{"id":"to-do-app-local-storage","message":"Create a to-do list application with local storage functionality.","titleHtml":"To-do list with local storage","icon":"code","color":"var(--display-gray-fgColor)"},{"id":"digital-clock-time-zones","message":"Create a digital clock that displays the current time in different time zones.","titleHtml":"A digital time zone clock","icon":"code","color":"var(--display-gray-fgColor)"},{"id":"weather-dashboard-app","message":"Develop a weather dashboard that fetches data from a public weather API.","titleHtml":"Develop a weather dashboard","icon":"code","color":"var(--display-gray-fgColor)"},{"id":"create-joke-generator","message":"Create a random joke generator using an external API.","titleHtml":"Create a joke generator","icon":"code","color":"var(--display-gray-fgColor)"}]}],"mcpPermissionGateEnabled":true,"spark":{"icebreakers":[{"type":"functional","data":[{"id":"family-calendar","message":"Create a family calendar app to keep track of family events","titleHtml":"Family calendar","icon":"calendar","color":"var(--fgColor-sponsors)"},{"id":"to-do-list-app","message":"Create a to-do list app where users can add tasks, mark them complete, and organize them into categories.","titleHtml":"To-do list app","icon":"checkbox","color":"var(--fgColor-link)"},{"id":"json-to-csv-converter","message":"Build a web app that converts JSON files to CSV format with file upload and download functionality.","titleHtml":"JSON to CSV converter","icon":"arrow-switch","color":"var(--fgColor-severe)"},{"id":"board-game-score-tracker","message":"Create an app to track scores for multiple players across different board games and save game history.","titleHtml":"Board game score tracker","icon":"number","color":"var(--fgColor-done)"},{"id":"media-rating-tracker","message":"Build an app where users can rate and review movies, books, and podcasts they've consumed.","titleHtml":"Media rating tracker","icon":"file-media","color":"var(--fgColor-done)"},{"id":"meal-and-grocery-planner","message":"Create an app for planning weekly meals and generating grocery shopping lists from those meals.","titleHtml":"Meal and grocery planner","icon":"book","color":"var(--fgColor-success)"},{"id":"expense-tracking-app","message":"Build a simple finance tracker for logging expenses, setting budgets, and viewing spending trends.","titleHtml":"Expense tracking app","icon":"credit-card","color":"var(--fgColor-success)"},{"id":"habit-tracking-app","message":"Design an app for tracking daily habits with streaks and progress visualization.","titleHtml":"Habit tracking app","icon":"tasklist","color":"var(--fgColor-done)"},{"id":"workout-log-app","message":"Create a fitness app for logging workouts and tracking exercise progress over time.","titleHtml":"Workout log app","icon":"goal","color":"var(--fgColor-closed)"},{"id":"password-generator-tool","message":"Build a tool that generates secure passwords based on user-specified criteria.","titleHtml":"Password generator tool","icon":"lock","color":"var(--fgColor-severe)"},{"id":"note-taking-app","message":"Create a simple note-taking app with markdown support and search functionality.","titleHtml":"Note taking app","icon":"pencil","color":"var(--fgColor-attention)"},{"id":"time-zone-converter","message":"Build a tool to convert times between different time zones and display multiple zones at once.","titleHtml":"Time zone converter","icon":"globe","color":"var(--fgColor-link)"},{"id":"recipe-collection-app","message":"Create an app for storing and organizing recipes with ingredient lists and cooking instructions.","titleHtml":"Recipe collection app","icon":"bookmark","color":"var(--fgColor-attention)"}]},{"type":"instructional","data":[]},{"type":"interactional","data":[]}]},"copilotSpacesConfig":{"maxDescriptionLength":350,"maxGeneralInstructionsLength":4000,"maxContentSize":288000,"maxResourceCount":300,"userHasOrgs":false},"showCopilotCodingAgentPremiumRequestsBanner":true,"currentUser":{"id":309194548,"login":"tuyendath09852-sys","primaryAvatarUrl":"https://avatars.githubusercontent.com/u/309194548?v=4"},"copilotChatSettingEnabled":true,"agentsEnabled":false,"sparkEnabled":false,"memberRequestEntities":{"orgs":{"requestable":[],"adminable":[]}},"optedInToPreviewFeatures":false,"optedInToUserFeedback":true,"renderBetaLabel":false,"hasCEorCBAccess":false,"licenseType":"licensed_limited","plan":"free","quotas":{"limits":{"premiumInteractions":0},"remaining":{"chat":185,"completions":2000,"premiumInteractions":0,"chatPercentage":92.6,"premiumInteractionsPercentage":0.0},"resetDate":"2026-11-01","resetDateUtc":"2026-11-01T00:00:00.000Z","overagesEnabled":false,"tokenBasedBillingEnabled":true,"chatQuota":{"percentRemaining":92.6,"total":200,"used":15.0,"hasQuota":true,"unlimited":false},"completionsQuota":{"percentRemaining":100.0,"total":2000,"used":0.0,"hasQuota":true,"unlimited":false},"premiumInteractionsQuota":{"percentRemaining":0.0,"total":0,"used":0.0,"hasQuota":false,"unlimited":false,"creditsUsed":0},"overageQuota":{"permitted":false,"percentRemaining":100.0,"budget":0.0,"spend":0.0}},"agentQuotaSnapshot":{"percent_remaining":0.0,"can_start_session":false,"can_upgrade_plan":true,"copilot_plan":"individual","is_paid_individual":false,"overage_permitted":false,"quota_reset_date":"2026-11-01","credits_used":0},"canShareThread":true,"thirdPartyMcpAllowed":true,"canUpgradePlan":true,"requestedTopic":null,"sharedThreadChannel":null,"autoSubmit":false,"transactionalMessageBanner":[],"copilotPromotionalBanner":{"campaign":"copilot_app","title":"The GitHub Copilot app","description":"An agent-driven desktop experience built natively on GitHub.","dismissPath":"/track-nudge-dismissal?id=accelerate_ipm_github_app_via_slash_copilot","nudgeId":"accelerate_ipm_github_app_via_slash_copilot","analytics":{"category":"accelerate_ipm_github_app_via_slash_copilot","label":"nudge_id:accelerate_ipm_github_app_via_slash_copilot;nudge_category:accelerate_ipm_github_app_via_slash_copilot;user:tuyendath09852-sys;","location":"copilot_home"},"primaryAction":{"id":"download-mac-silicon","label":"Download for macOS (Silicon)","href":"https://gh.io/copilot-app-mac","analyticsAction":"slide_0_download_for_mac_silicon","openInNewTab":true},"testSelector":"copilot-app-banner","label":"New","actionMenu":{"ariaLabel":"Choose a GitHub Copilot app download","analyticsAction":"slide_0_download_dropdown_opened","variant":"download_menu","items":[{"id":"download-mac-silicon","label":"macOS (Silicon)","variant":"mac","href":"https://gh.io/copilot-app-mac","analyticsAction":"slide_0_download_for_mac_silicon","openInNewTab":true},{"id":"download-mac-intel","label":"macOS (Intel)","variant":"mac","href":"https://gh.io/copilot-app-mac-intel","analyticsAction":"slide_0_download_for_mac_intel","openInNewTab":true},{"id":"download-win-x64","label":"Windows (x64)","variant":"windows","href":"https://gh.io/copilot-app-win64","analyticsAction":"slide_0_download_for_win_x64","openInNewTab":true},{"id":"download-win-arm","label":"Windows (ARM)","variant":"windows","href":"https://gh.io/copilot-app-win-arm","analyticsAction":"slide_0_download_for_win_arm","openInNewTab":true},{"id":"download-linux","label":"Linux","variant":"linux","href":"https://gh.io/copilot-app-linux","analyticsAction":"slide_0_download_for_linux","openInNewTab":true}]},"sendDownloadLinkAction":{"label":"Send me a download link","endpoint":"/copilot/desktop_download_link","analyticsAction":"send_download_link"}},"sso_organizations":[],"current_sso_orgs_match_dismissed_cookie":true,"enabled_features":{"copilot_pro_plus_animation":false,"copilot_web_integration_cutover":false}}}</script>
